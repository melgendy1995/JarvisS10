## Copy to local.properties. Never commit real keys.
sdk.dir=/path/to/Android/sdk

## Left empty on purpose. Gemini runs through Firebase, not through a key in the APK.
GEMINI_API_KEY=
## Worker origin only, for example https://jarvis-groq-proxy.<account>.workers.dev
## The Worker bearer is pasted in the app (long-press the state word). Never put it here.
GROQ_PROXY_URL=
